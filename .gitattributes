# Force Windows line endings (CRLF) for all text files
* text=auto eol=crlf encoding=UTF-8

# Binary files
*.lib binary
*.dll binary
*.so binary
*.dylib binary
*.a binary
*.exe binary
*.ico binary
*.cur binary
*.bmp binary
*.png binary
*.gif binary
*.icns binary
*.pdf binary
*.db binary
*.sqlite binary

# Scripts with POSIX shebangs must keep LF — CRLF breaks execution on
# macOS and Linux ("bad interpreter: /usr/bin/env ...^M").
*.sh text eol=lf
*.py text eol=lf

# codesign hands entitlements to the kernel's AMFI XML parser, which rejects
# CRLF outright ("AMFIUnserializeXML: syntax error near line 1").
*.plist text eol=lf
