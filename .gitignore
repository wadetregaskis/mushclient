.*
!.gitignore
!.gitattributes
!packaging/.build-*.sh
!packaging/.sign-mac.sh
!.github/

#
#  Help file is generated from database
#
MUSHCLIENT.HLP

# 
#  These two directories are where the object and .exe files are generated
# 
WinRel
WinDebug
WinTest

#
#  These two files are generated by MUSHclient during testing
# 
mushclient_prefs.sqlite
MUSHclient.ini

# 
#  These two files are generated during the install, to generate localization files
#
all_files_list.txt
Localize_template.lua

#
#  This searches all files for funny problems
#
find_non_standard_encoding.lua

# 
#  Compiler work files, editor backups, DLLs used for testing, etc.
#
*.ncb
*.plg
*.opt
*.aps
*.bak
*.dll
*.fon
*.po
*.GID
*.suo
*.clw

#
#  Notes for me:
#

using_git.txt


#
#  VS2005 user-specific project data
#  
MUSHclient.vcproj.*

#
# VS2010 user-specific project data
#
*.vcxproj.user
MUSHclient.sdf
MUSHclient.opensdf
ipch

#
# Help database (generated)
#
help.db
documentation_fixed.sql

#
# TinyGL stuff
#
TinyGL*

#
# temporary files
#
git_diff_output.txt
git_log_output.txt

#
# macOS/Linux port build artefacts
#
build*/
*.o
commit-phase1.sh
scripting/methods/methods_sounds_patch.py

#
# Packaging: build output + staged third-party plugins (Quow's Discworld pack).
# Quow's plugins are NOT ours to redistribute — never commit them.
#
dist/
packaging/discworld-plugins/

#
# Port working notes (not part of project history)
#
LOGBOOK.md
PLAN.md
CLAUDE.md

# Vendored runtimes (fetched/built, not committed)
packaging/python/
packaging/tcl/
packaging/ruby/
packaging/openssl/
packaging/wx/
packaging/resources/
.claude-audit/

# MSVC drops the precompiled header in the SOURCE directory, not WinDebug
# (the project sets no <PrecompiledHeaderOutputFile>), so it lands here as a
# ~50 MB untracked file after every Windows build.
*.pch
